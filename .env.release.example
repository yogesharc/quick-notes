# Copy to .env.release (gitignored) and fill in. Used only by scripts/release.sh.

# Signs the update bundle. Separate from Apple's signature and not optional:
# without it the app refuses the download. Generated with `pnpm tauri signer
# generate`; the matching public key is in src-tauri/tauri.conf.json.
TAURI_SIGNING_PRIVATE_KEY_PATH=~/.tauri/quick-notes.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# `security find-identity -v -p codesigning` lists these. The team id is the
# parenthesised suffix of the identity.
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
APPLE_TEAM_ID=TEAMID1234

# An app-specific password from appleid.apple.com, not your Apple ID password.
APPLE_ID=
APPLE_PASSWORD=
